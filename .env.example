# APP_URL: Optional public URL where this app is hosted (e.g. for sharing invite links).
# If omitted, window.location.origin is used automatically.
APP_URL=

# PORT: Server port (defaults to 3000 in Node/containers).
PORT=3000

# GEMINI_API_KEY: Optional API key for server-side AI Judge in Power Clash mode.
# When omitted, PickBattle automatically uses the built-in resilient heuristic judge without error.
GEMINI_API_KEY=
